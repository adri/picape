{
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 19006",
    "build:web": "expo export --platform web && node scripts/build-service-worker.js",
    "eject": "expo eject",
    "test": "jest --ci",
    "test:watch": "jest --watchAll",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run graphql:check && npm test",
    "graphql:check": "node scripts/check-operations.js"
  },
  "eslintConfig": {
    "extends": "universe/native",
    "env": {
      "browser": true
    },
    "rules": {
      "react-hooks/rules-of-hooks": "warn"
    },
    "overrides": [
      {
        "files": [
          "scripts/**"
        ],
        "env": {
          "node": true
        }
      }
    ]
  },
  "jest": {
    "preset": "jest-expo/web"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@sentry/browser": "^10.73.0",
    "expo": "^57.0.19",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.16",
    "expo-blur": "~57.0.2",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-splash-screen": "~57.0.8",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "graphql": "15.0.0",
    "phoenix": "^1.8.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-hyperlink": "0.1.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-typography": "1.4.1",
    "react-native-web": "^0.21.0",
    "sentry-expo": "~7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "babel-preset-expo": "~57.0.10",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^11.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "workbox-build": "^7.4.1"
  },
  "private": true
}
