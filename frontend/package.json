{
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "NODE_OPTIONS=--openssl-legacy-provider expo start --web",
    "build:web": "NODE_OPTIONS=--openssl-legacy-provider npx expo export:web",
    "eject": "expo eject",
    "test": "jest --ci",
    "test:watch": "jest --watchAll",
    "lint": "eslint . --ext .js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run graphql:check && npm test",
    "graphql:check": "node scripts/check-operations.js"
  },
  "eslintConfig": {
    "extends": "universe/native",
    "env": {
      "browser": true
    },
    "rules": {
      "react-hooks/rules-of-hooks": "warn"
    },
    "overrides": [
      {
        "files": [
          "src/service-worker.js"
        ],
        "env": {
          "serviceworker": true
        }
      },
      {
        "files": [
          "scripts/**"
        ],
        "env": {
          "node": true
        }
      }
    ]
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@absinthe/socket": "^0.2.1",
    "@absinthe/socket-apollo-link": "0.2.1",
    "@apollo/client": "^3.8.8",
    "@expo/vector-icons": "^14.0.0",
    "@expo/webpack-config": "^19.0.0",
    "@react-native-masked-view/masked-view": "0.3.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@react-spring/native": "9.0.0-beta.33",
    "@sentry/browser": "^5.19.0",
    "expo": "^50.0.21",
    "expo-asset": "~9.0.2",
    "expo-blur": "~12.9.2",
    "expo-constants": "~15.4.6",
    "expo-font": "~11.10.3",
    "expo-linear-gradient": "~12.7.2",
    "expo-linking": "~6.2.2",
    "expo-splash-screen": "~0.26.5",
    "expo-updates": "~0.24.13",
    "expo-web-browser": "~12.8.2",
    "graphql": "15.0.0",
    "phoenix": "1.4.16",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.73.6",
    "react-native-gesture-handler": "~2.14.0",
    "react-native-hyperlink": "0.0.19",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "~3.29.0",
    "react-native-skeleton-content": "1.0.28",
    "react-native-svg": "14.1.0",
    "react-native-typography": "1.4.1",
    "react-native-web": "~0.19.6",
    "sentry-expo": "~7.2.0",
    "workbox-webpack-plugin": "^6.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "babel-preset-expo": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^11.1.1",
    "jest": "^29.7.0",
    "jest-expo": "^50.0.4",
    "prettier": "2.8.8",
    "react-test-renderer": "^18.2.0"
  },
  "private": true
}
