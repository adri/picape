#!/usr/bin/env bash
# Starts Phoenix on :4010 against your dev database and the live supermarket API.
# --fake: resets the seeded picape_e2e database and talks to the supermarket fake on :4020.
# --db NAME: use that database instead (with --fake it is kept as it is, no reset).
set -euo pipefail
source "$(cd "$(dirname "$0")" && pwd)/_toolchain"
cd "$(dirname "$0")/.."
mkdir -p tmp
docker compose up -d --wait postgres >/dev/null
MODE=live
FAKE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --fake) FAKE=1 ;;
    --db) export PICAPE_DB="$2"; shift ;;
    *) echo "usage: bin/phx [--fake] [--db NAME]" >&2; exit 1 ;;
  esac
  shift
done
if [[ $FAKE == 1 ]]; then
  MODE=fake
  export SUPERMARKET_BASE_URL=http://localhost:4020 SUPERMARKET_REFRESH=0 PICAPE_LOG_LEVEL="${PICAPE_LOG_LEVEL:-info}"
  if [[ -z "${PICAPE_DB:-}" ]]; then
    export PICAPE_DB=picape_e2e
    mix do ecto.drop --quiet, ecto.create --quiet, ecto.migrate --quiet, run priv/repo/seeds.exs
  else
    echo "fake mode on existing database $PICAPE_DB (no reset)"
  fi
fi
echo "$MODE" > tmp/phx.mode
trap 'rm -f tmp/phx.mode' EXIT
mix phx.server
