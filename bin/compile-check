#!/usr/bin/env bash
# Fails on compile warnings, except the four deprecation notices Absinthe 1.5
# emits on Elixir 1.18. Replace with `mix compile --warnings-as-errors` after
# the Absinthe upgrade.
set -uo pipefail
cd "$(dirname "$0")/.."
export MIX_ENV="${MIX_ENV:-test}"
output=$(mix compile --force 2>&1)
status=$?
if [[ $status -ne 0 ]]; then
  echo "$output" | tail -20
  exit $status
fi
absinthe=$(echo "$output" | grep -c "warning: using map.field notation .* \(Absinthe\|PicapeWeb.Graphql.Schema\)")
other=$(echo "$output" | grep -v "map.field notation" | grep -c "warning:")
if [[ $absinthe -ne 4 || $other -ne 0 ]]; then
  echo "$output" | grep -B1 -A8 "warning:"
  echo "compile-check: $other warnings, $absinthe Absinthe deprecation notices (expected 0 and 4)" >&2
  exit 1
fi
echo "compile-check: no warnings"
