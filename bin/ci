#!/usr/bin/env bash
#
# Continuous Integration Script
#
# Runs the same checks as .github/workflows/ci.yml so you can reproduce a
# CI failure locally. Needs Postgres (docker compose up -d postgres).
set -xe
export MIX_ENV=test

mix local.rebar --force
mix local.hex --force
mix deps.get
mix check

cd frontend
npm ci --no-audit --no-fund
npm run check
